# 是否打开mock（mock模式强制为true）
VITE_USE_MOCK = true
# mock服务端口，默认是3100
VITE_MOCK_SERVER = http://localhost:3100
# 后端真实接口地址
VITE_API_URL=/jeecgboot

# 发布路径
VITE_PUBLIC_PATH = /

# 跨域代理（mock开启时代理不生效，保持注释状态）
VITE_PROXY = [["/jeecgboot","http://192.168.18.40:8080/jeecg-boot"],["/upload","http://192.168.18.40:3300/upload"]]

#后台接口全路径地址(mock模式这里填默认值，不要空)
# VITE_GLOB_DOMAIN_URL=http://192.168.18.40:8080/jeecg-boot
VITE_GLOB_DOMAIN_URL=

#后台接口父地址【mock必须是 /jeecgboot，不能写 /api！】
VITE_GLOB_API_URL=/jeecgboot

# 接口前缀
VITE_GLOB_API_URL_PREFIX=

# 在线文档编辑版本
VITE_GLOB_ONLINE_DOCUMENT_VERSION=wps

# icon组件的iconify图标库使用在线还是本地
VITE_GLOB_ICONIFY_USE_TYPE=online

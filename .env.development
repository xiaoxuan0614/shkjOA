# 是否打开mock
VITE_USE_MOCK = false
# mock服务端口，默认是3100
VITE_MOCK_SERVER = http://localhost:3100§

# 后端真实接口地址
VITE_API_URL=/shouhuiApi

# 发布路径
VITE_PUBLIC_PATH = /

# 跨域代理（mock开启时代理不生效，但配置不能删掉注释，保留原内容注释）
# VITE_PROXY = [["/shouhuiApi","http://192.168.18.2:8080/shouhuiApi"],["/upload","http://192.168.18.2:3300/upload"]]
VITE_PROXY = [["/shouhuiApi","http://10.10.10.10:8080/shouhuiApi"],["/upload","http://192.168.18.40:3300/upload"]]

#后台接口全路径地址(mock模式这里填默认值，不要空)
# VITE_GLOB_DOMAIN_URL=http://192.168.18.2:8080/shouhuiApi
VITE_GLOB_DOMAIN_URL=http://10.10.10.10:8080/shouhuiApi

# VITE_GLOB_DOMAIN_URL=


#后台接口父地址【mock必须是 /jeecgboot，不能写 /api！】
VITE_GLOB_API_URL=/shouhuiApi

# 接口前缀
VITE_GLOB_API_URL_PREFIX=

# 在线文档编辑版本
VITE_GLOB_ONLINE_DOCUMENT_VERSION=wps

# icon组件的iconify图标库使用在线还是本地
VITE_GLOB_ICONIFY_USE_TYPE=online